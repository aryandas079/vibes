# Auto detect text files and perform LF normalization
* text=auto

# Ensure gradlew has LF line endings for Linux/macOS compatibility
/gradlew text eol=lf
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
*.aar binary
